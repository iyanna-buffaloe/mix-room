{
  "name": "mix-room",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "lab": "node projects/annotation-lab/server.js",
    "test:lab": "node --test \"projects/annotation-lab/*.test.js\" && node projects/local-audio/python.js -m unittest discover -s projects/annotation-lab -p \"test_*.py\"",
    "build": "vite build && node scripts/build-separation-function.js",
    "doctor": "node projects/local-audio/python.js projects/local-audio/analysis/check_setup.py",
    "benchmark": "node projects/local-audio/python.js projects/local-audio/analysis/benchmark.py",
    "server": "node --env-file-if-exists=.env.local server/index.js",
    "dev": "vite",
    "start": "vite",
    "start:server": "concurrently \"npm run server\" \"npm run dev\"",
    "lint": "oxlint .",
    "test": "node --test \"src/**/*.test.js\" \"server/**/*.test.js\" \"shared/*.test.js\" \"scripts/*.test.js\" \"projects/**/*.test.js\"",
    "test:watch": "node --test --watch \"src/**/*.test.js\" \"server/**/*.test.js\" \"shared/*.test.js\" \"scripts/*.test.js\" \"projects/**/*.test.js\"",
    "test:python": "node projects/local-audio/python.js -m unittest discover -s projects/local-audio/analysis -p \"test_*.py\"",
    "check": "npm run lint && npm test && npm run build",
    "local:server": "node projects/local-audio/server.js",
    "cleanup:mixes": "node --env-file-if-exists=.env.local server/mixes/cleanup.js",
    "test:browser": "node --test scripts/checkAccountAccess.mjs && node scripts/checkAccountWorkspace.mjs && node scripts/checkAccountSettings.mjs",
    "test:design": "node scripts/checkDesign.mjs",
    "review": "node scripts/checkDesign.mjs --review-only",
    "test:account-settings": "node scripts/checkAccountSettings.mjs",
    "test:library:live": "node --env-file-if-exists=.env.local scripts/checkRealLibrary.mjs --live",
    "test:email-verification:live": "node --env-file-if-exists=.env.local scripts/checkEmailVerificationLive.mjs --live",
    "test:account-provider:live": "node --env-file-if-exists=.env.local scripts/checkAccountProviderLive.mjs --live",
    "test:library:hosted": "node --env-file-if-exists=.env.local scripts/checkRealLibrary.mjs --live --hosted",
    "test:credits:live": "node --env-file-if-exists=.env.local scripts/checkHostedCreditsLive.mjs --live",
    "test:email-page": "node --env-file-if-exists=.env.local scripts/checkEmailLanding.mjs",
    "test:email-page:live": "node --env-file-if-exists=.env.local scripts/checkEmailLandingLive.mjs --live",
    "test:protected-actions": "node scripts/checkProtectedActions.mjs",
    "test:auth": "node --test \"src/auth/*.test.js\" && node --test scripts/checkAccountAccess.mjs",
    "test:auth:browsers": "node --test \"src/auth/*.test.js\" && node scripts/checkAccountBrowsers.mjs",
    "test:fullscreen": "node scripts/checkDesign.mjs --fullscreen-only",
    "test:editor": "node scripts/checkDesign.mjs --editor-only",
    "backup:prepare": "node scripts/backups/run.mjs prepare",
    "backup:secret": "node scripts/backups/run.mjs secret",
    "backup:init": "node scripts/backups/run.mjs init",
    "backup:run": "node scripts/backups/run.mjs run",
    "backup:verify": "node scripts/backups/run.mjs verify",
    "backup:status": "node scripts/backups/run.mjs status",
    "backup:test-alert": "node scripts/backups/run.mjs test-alert",
    "backup:install": "node scripts/backups/run.mjs install",
    "test:backups": "node --test scripts/backup.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@netlify/blobs": "^11.1.4",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@supabase/supabase-js": "2.118.0",
    "express": "^5.2.1",
    "mediabunny": "^1.61.3",
    "multer": "^2.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "oxlint": "^1.81.0",
    "pg": "8.23.1",
    "playwright": "1.64.1",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
