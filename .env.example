# Public browser account settings (not secrets). Copy to .env.local for local development.
# Use a publishable key (sb_publishable_...), never a secret/service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only settings. Secret: MVSEP_API_KEY, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY.
# R2_ACCOUNT_ID and R2_BUCKET_NAME are configuration identifiers, not secrets.
# In Netlify, enter these in Project configuration > Environment variables.
# Never add VITE_ to these names.
MVSEP_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=mix-room-uploads

# Private saved mixes: server-only Supabase secret and a DISTINCT durable bucket.
# SUPABASE_URL and R2_SAVED_MIXES_BUCKET_NAME are not secrets; SUPABASE_SECRET_KEY is.
# Never give the saved/ prefix an automatic expiry lifecycle rule.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
R2_SAVED_MIXES_BUCKET_NAME=

# Default: ten attempted paid jobs per UTC calendar month, six minutes each.
SEPARATION_MONTHLY_JOBS=10
SEPARATION_MAX_SECONDS=360
SEPARATION_ENABLED=true
# Thorough (chained MVSEP jobs) is paused: MVSEP now blocks its own stem URLs
# as inputs. Leave unset until chained inputs are re-hosted, then set to true
# and flip THOROUGH_AVAILABLE in src/config/features.js.
# SEPARATION_THOROUGH_ENABLED=true

# Optional server-only preview test scope. IDs are nonsecret. Leave both unset
# for normal processing. Setting either requires both valid UUIDs, and permits
# only that verified account and job ID in Quick mode. Configure on Friday only.
# SEPARATION_TEST_ACCOUNT_ID=<disposable-account-uuid>
# SEPARATION_TEST_JOB_ID=<single-approved-job-uuid>
